# ─────────────────────────────────────────────────────────────────────────────
# ARIA Distribution Gateway — example environment configuration
#
# Copy this file to .env and fill in the values for your environment.
# .env is git-ignored; never commit real credentials.
# ─────────────────────────────────────────────────────────────────────────────

# ── API ──────────────────────────────────────────────────────────────────────

# Public base URL that the API uses when building manifest hrefs.
# In docker-compose this should match the gateway's public address.
# API_BASE_URL=http://localhost:8080

# ── Catalog source ────────────────────────────────────────────────────────────
#
# Local / offline mode — serve built-in sample assets (no registry required).
# Useful for local development and docker-compose demos.
#
#   CATALOG_PROVIDER=sample
#   CATALOG_SAMPLE_MODE=true
#
# Remote registry mode (default) — pull assets from an OCI registry.
# Leave CATALOG_PROVIDER unset or set to "registry".
#
CATALOG_PROVIDER=registry
CATALOG_SAMPLE_MODE=false

# OCI registry to pull catalog assets from.
# Defaults to https://ghcr.io / aria-fx/aria-assets:latest when not set.
# CATALOG_REGISTRY_URL=https://ghcr.io
# CATALOG_REGISTRY_REPOSITORY=aria-fx/aria-assets
# CATALOG_REGISTRY_REFERENCE=latest

# Token used to authenticate against the catalog registry.
# For GitHub Container Registry, use a PAT with `read:packages` scope.
# CATALOG_REGISTRY_TOKEN=ghp_…

# ── Auth (optional) ───────────────────────────────────────────────────────────

# Set to "true" to require a valid Entra JWT on every request.
# AUTH_ENFORCE=false

# Azure AD tenant ID — used to build the issuer and JWKS URLs automatically.
# ENTRA_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Expected "aud" claim in incoming JWTs (app/client ID or URI).
# ENTRA_AUDIENCE=api://aria-gateway

# ── UI ────────────────────────────────────────────────────────────────────────
#
# Build-time base URL that the React UI uses for catalog API calls.
# The default (/catalog) works through the nginx gateway proxy.
# Override only when the UI should call the API directly (e.g. a remote host).
#
# VITE_API_URL=/catalog
